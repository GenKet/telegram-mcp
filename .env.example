# Telegram API credentials
# Get them from https://my.telegram.org/apps
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# Phone number for the account (with country code)
PHONE=

# Session string (recommended — obtain via: poetry run telegram-mcp-auth)
# More secure than a file-based session
SESSION_STRING=

# Session name (fallback if SESSION_STRING is not set — creates a .session file)
SESSION_NAME=telegram_mcp_session

# OpenAI API key — required only for AI tools (ai_send_message, ai_send_voice,
# transcribe_voice, analyze_voice)
OPENAI_API_KEY=
